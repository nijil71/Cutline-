{
  "manifest_version": 3,
  "name": "Cutline",
  "version": "1.1.0",
  "description": "Screenshots named from the page they came from — the product, ticket, or error — instead of a timestamp.",
  "minimum_chrome_version": "116",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite",
    "notifications",
    "contextMenus"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Cutline — capture a region (right-click the page for full-page capture)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Capture a region"
    },
    "capture-viewport": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Capture the whole visible page"
    },
    "capture-fullpage": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Capture the full scrolling page"
    }
  }
}
